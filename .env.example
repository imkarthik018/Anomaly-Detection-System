# Copy this file to ".env" in the same folder (next to sample_login_events.csv).
# Never commit .env to git — it holds secrets.

# The Gmail account that sends mail (must match App Password below).
EMAIL_ADDRESS=youraccount@gmail.com

# Gmail App Password (16 characters). Create at:
# Google Account → Security → 2-Step Verification → App passwords
# Do NOT use your normal Gmail password — Google will return error 535.
EMAIL_PASSWORD=abcd efgh ijkl mnop

# Who receives alerts (default is fine for you).
TO_EMAIL=vjkarthiabi@gmail.com

# Optional: set to 1 to turn off SMTP while testing
# SKIP_EMAIL=1
